{
  "expo": {
    "name": "Selah",
    "slug": "selah-app",
    "version": "1.0.0",
    "scheme": "selah",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF6EF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yallasolucoes.selah",
      "infoPlist": { "UIBackgroundModes": ["audio"] }
    },
    "android": {
      "package": "com.yallasolucoes.selah",
      "adaptiveIcon": {
        "backgroundColor": "#FAF6EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": { "favicon": "./assets/favicon.png", "bundler": "metro" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      ["expo-audio", { "microphonePermission": false }],
      ["expo-notifications", { "color": "#C8A96A" }],
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "backgroundColor": "#FAF6EF", "dark": { "backgroundColor": "#1B1511" } }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
